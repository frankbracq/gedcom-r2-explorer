{
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "gedcom-r2-explorer",
	"routes": [
		{
			"pattern": "files.genealogie.app",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "node_modules/r2-explorer/dashboard",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "bucket",
			"bucket_name": "gedcom-files",
			"preview_bucket_name": "gedcom-files"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
